# Maintainer: Preygle <https://github.com/Preygle>
# __VERSION__ and __SHA256__ are filled in by the release workflow.
pkgname=mangabinder
pkgver=__VERSION__
pkgrel=1
pkgdesc="Download manga chapters, convert them to PDF, bind them into volumes and export CBZ"
arch=('any')
url="https://github.com/Preygle/manga-downloader"
license=('MIT')
depends=('python' 'python-pillow' 'python-tqdm' 'python-pypdf' 'python-pypdfium2')
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-wheel')
optdepends=('tk: desktop PDF to CBZ window (mangabinder gui)')
source=("https://github.com/Preygle/manga-downloader/releases/download/v$pkgver/mangabinder-$pkgver.tar.gz")
sha256sums=('__SHA256__')

build() {
  cd "mangabinder-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "mangabinder-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
